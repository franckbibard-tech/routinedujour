<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/bg_todo"
            android:text="@string/msg_todo"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:text="@string/btn_done"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_undo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_undo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/reminders"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton android:id="@+id/mode_widget"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/mode_widget" />
            <RadioButton android:id="@+id/mode_fixed"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/mode_fixed" />
            <RadioButton android:id="@+id/mode_repeat"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/mode_repeat" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/repeat_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat_every" />

            <RadioGroup
                android:id="@+id/interval_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/every_15"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp" android:text="@string/every_15" />
                <RadioButton android:id="@+id/every_30"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp" android:text="@string/every_30" />
                <RadioButton android:id="@+id/every_60"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/every_60" />
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
